{
  "name": "jevcomp",
  "version": "0.7.6",
  "description": "Jev-guided Codex compaction with conservative post-compaction dedupe, TypeSafe and OpenRouter.",
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=20"
  },
  "bin": {
    "jevcomp": "dist/cli.js"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "hooks",
    ".claude-plugin",
    "skills",
    "AUDIT.md",
    "README.md",
    "LICENSE",
    "NOTICE"
  ],
  "scripts": {
    "clean": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\"",
    "build": "npm run clean && tsc -p tsconfig.json",
    "test": "npm run build && node --test tests/*.test.mjs",
    "check": "npm run test",
    "prepack": "npm run build"
  },
  "devDependencies": {
    "typescript": "^5.8.3"
  }
}
